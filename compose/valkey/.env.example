# Valkey (Alpine) — environment variables
# Copy this file to .env and adjust values for your environment.

# Password for client connections. By default Valkey starts with no password
# (any client can connect). To require authentication:
#   1. Set VALKEY_PASSWORD below
#   2. Uncomment the "command" line in docker-compose.yaml
# Clients authenticate with: AUTH <password>
# VALKEY_PASSWORD=valkey
