# MariaDB — environment variables
# Copy this file to .env and adjust values for your environment.

# Root password.
# The default is for local development only — always change for production.
MARIADB_ROOT_PASSWORD=mariadb

# Database created automatically on first start (default: mariadb).
MARIADB_DATABASE=mariadb

# Additional user created automatically on first start (default: mariadb).
MARIADB_USER=mariadb

# Password for the additional user.
# The default is for local development only — always change for production.
MARIADB_PASSWORD=mariadb
