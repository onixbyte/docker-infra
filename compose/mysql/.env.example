# MySQL (Alpine) — environment variables
# Copy this file to .env and adjust values for your environment.

# Root password.
# The default is for local development only — always change for production.
MYSQL_ROOT_PASSWORD=mysql

# Database created automatically on first start (default: mysql).
MYSQL_DATABASE=mysql

# Additional user created automatically on first start (default: root).
MYSQL_USER=root

# Password for the additional user.
# The default is for local development only — always change for production.
MYSQL_PASSWORD=mysql
