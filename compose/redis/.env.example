# Redis (Alpine) — environment variables
# Copy this file to .env and adjust values for your environment.

# Password for client connections. By default Redis starts with no password
# (any client can connect). To require authentication:
#   1. Set REDIS_PASSWORD below
#   2. Uncomment the "command" line in docker-compose.yaml
# Clients authenticate with: AUTH <password>
# REDIS_PASSWORD=redis
