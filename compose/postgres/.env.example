# PostgreSQL (Alpine) — environment variables
# Copy this file to .env and adjust values for your environment.

# Superuser name (default: postgres).
POSTGRES_USER=postgres

# Superuser password.
# The default is for local development only — always change for production.
POSTGRES_PASSWORD=postgres

# Default database created automatically on first start.
# Defaults to the value of POSTGRES_USER if not set.
POSTGRES_DB=postgres
